{
  "datasets": [
    {
      "name": "ventas_por_segmento",
      "displayName": "Ventas por segmento de cliente",
      "queryLines": [
        "SELECT c.segmento, ROUND(SUM(f.monto_total), 2) AS ventas_totales FROM ventas_retail_gmotta.gold.fact_ventas f JOIN ventas_retail_gmotta.gold.dim_cliente c ON f.customer_key = c.customer_key GROUP BY c.segmento ORDER BY ventas_totales DESC"
      ]
    },
    {
      "name": "ventas_por_canal",
      "displayName": "Ventas por canal de venta",
      "queryLines": [
        "SELECT f.canal_venta, ROUND(SUM(f.monto_total), 2) AS ventas_totales FROM ventas_retail_gmotta.gold.fact_ventas f GROUP BY f.canal_venta ORDER BY ventas_totales DESC"
      ]
    },
    {
      "name": "ticket_promedio_pedido",
      "displayName": "Ticket promedio por pedido",
      "queryLines": [
        "WITH pedido_totales AS (SELECT order_id, SUM(monto_total) AS monto_pedido FROM ventas_retail_gmotta.gold.fact_ventas GROUP BY order_id) SELECT ROUND(AVG(monto_pedido), 2) AS ticket_promedio_por_pedido FROM pedido_totales"
      ]
    },
    {
      "name": "top_10_productos",
      "displayName": "Top 10 productos por cantidad vendida",
      "queryLines": [
        "SELECT pr.nombre_producto, pr.categoria, SUM(f.cantidad) AS unidades_vendidas FROM ventas_retail_gmotta.gold.fact_ventas f JOIN ventas_retail_gmotta.gold.dim_producto pr ON f.product_key = pr.product_key GROUP BY pr.nombre_producto, pr.categoria ORDER BY unidades_vendidas DESC LIMIT 10"
      ]
    }
  ],
